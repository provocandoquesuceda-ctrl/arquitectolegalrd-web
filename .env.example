# Public Supabase values. Safe for browser use when RLS is correctly configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only if the project still uses the anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public canonical origin used for email confirmation callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=
